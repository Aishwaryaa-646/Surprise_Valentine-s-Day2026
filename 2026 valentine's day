<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sreee Papaa 💍</title>

<style>
body{
margin:0;
font-family:'Segoe UI';
background:linear-gradient(to right,#ff758c,#ff7eb3);
text-align:center;
overflow:hidden;
color:white;
}

/* Floating hearts */
.heart{
position:absolute;
font-size:24px;
animation:float 6s linear infinite;
}
@keyframes float{
0%{transform:translateY(100vh);opacity:1;}
100%{transform:translateY(-10vh);opacity:0;}
}

.page{
display:none;
padding:30px;
animation:fade 1s ease-in-out;
}
.active{display:block;}

@keyframes fade{
from{opacity:0;transform:scale(0.9);}
to{opacity:1;transform:scale(1);}
}

button{
padding:12px 20px;
border:none;
border-radius:25px;
background:#ff1e56;
color:white;
font-size:16px;
margin:10px;
box-shadow:0 0 15px pink;
}

img{
width:85%;
border-radius:20px;
margin-top:20px;
box-shadow:0 0 25px white;
}

.bouquet{
font-size:60px;
animation:bounce 2s infinite;
}
.teddy{
font-size:60px;
animation:pop 2s infinite alternate;
}
@keyframes bounce{
0%,100%{transform:translateY(0);}
50%{transform:translateY(-15px);}
}
@keyframes pop{
0%{transform:scale(1);}
100%{transform:scale(1.2);}
}

.glow{
animation:glow 1.5s infinite alternate;
}
@keyframes glow{
from{text-shadow:0 0 5px white;}
to{text-shadow:0 0 20px red;}
}

#yesScreen{
display:none;
font-size:30px;
animation:zoom 1s ease forwards;
}
@keyframes zoom{
from{transform:scale(0);}
to{transform:scale(1);}
}
</style>
</head>

<body>

<script>
for(let i=0;i<25;i++){
let heart=document.createElement("div");
heart.className="heart";
heart.innerHTML="💖";
heart.style.left=Math.random()*100+"%";
heart.style.animationDuration=(3+Math.random()*3)+"s";
document.body.appendChild(heart);
}
</script>

<!-- PAGE 1 -->
<div class="page active" id="page1">
<h1 class="glow">Sreee Papaa ❤️</h1>
<h2>You are the best thing that ever happened to me 🥺</h2>
<button onclick="goPage(2)">Next ➜</button>
</div>

<!-- PAGE 2 -->
<div class="page" id="page2">
<img src="photo.jpg">
<h2>Every moment with you feels magical ✨</h2>
<button onclick="goPage(3)">Next ➜</button>
</div>

<!-- PAGE 3 -->
<div class="page" id="page3">
<div class="bouquet">💐</div>
<h2>You are my sunshine on cloudy days ☀️</h2>
<button onclick="goPage(4)">Next ➜</button>
</div>

<!-- PAGE 4 -->
<div class="page" id="page4">
<div class="teddy">🧸</div>
<h2>Love you gundu payya 😘</h2>
<h2>I want to grow old with you ❤️</h2>
<button onclick="goPage(5)">Next ➜</button>
</div>

<!-- PAGE 5 -->
<div class="page" id="page5">
<h2>With you, I found my forever 💞</h2>
<h2>You are my today, tomorrow and always 💍</h2>
<button onclick="goPage(6)">Next ➜</button>
</div>

<!-- PAGE 6 PROPOSAL -->
<div class="page" id="page6">
<h1 class="glow">💍 Will You Marry Me? 💍</h1>
<button onclick="showYes()">YES ❤️</button>
<button onclick="alert('No option not available 😌')">No</button>
</div>

<!-- YES SCREEN -->
<div id="yesScreen">
<h1>🥰💞💖💍💑</h1>
<h2>Forever Yours,  
Your Kannamaa 💋</h2>
<h1>🤗🤗🤗</h1>
</div>

<script>
function goPage(n){
document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));
document.getElementById("page"+n).classList.add("active");
}

function showYes(){
document.querySelectorAll(".page").forEach(p=>p.style.display="none");
document.getElementById("yesScreen").style.display="block";
}
</script>

</body>
</html>
